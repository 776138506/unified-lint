// 规则：禁止在代码中硬编码密码、密钥等敏感信息
language python

or {
  `$var = $password`,
  `$var = $secret`
} where {
  $password <: or {
    r"['\"].*['\"]",
  },
  $secret <: or {
    r"['\"].*['\"]",
  },
  or {
    $var <: r"(?i).*password.*",
    $var <: r"(?i).*secret.*",
    $var <: r"(?i).*api_key.*"
  },
  // 排除环境变量引用
  $password <: not r".*os\.environ.*",
  $password <: not r".*os\.getenv.*",
  register_diagnostic(
    message = "禁止硬编码敏感信息，请使用环境变量或配置中心",
    severity = "error"
  )
}
